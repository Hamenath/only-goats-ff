# ==============================================================================
# ONLY GOATS FREE FIRE TOURNAMENT - ENVIRONMENT CONFIGURATION
# Production-ready .env.example for Netlify / Next.js 16 App Router
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Required for Frontend Firestore & Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. BACKEND API URL
# Leave blank for Netlify same-origin API Serverless Functions (/api/*)
# Or set to an external backend URL if hosted separately (e.g., https://api.example.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA CDN CONFIGURATION (Required for Image/Screenshot Uploads)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=only_goats_uploads

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN / SERVER CONFIGURATION (Required if using standalone backend)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789012345678901
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# ------------------------------------------------------------------------------
# 5. GENERAL APP & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-netlify-app.netlify.app
